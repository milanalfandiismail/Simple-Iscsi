#!ipxe
:start
echo
echo    ==========================================
echo
echo          ~ PXE SB Milannn v1.0 ~
echo
echo    ==========================================
echo
dhcp
echo
echo        IP Address  : ${net0/ip}
echo        MAC Address : ${net0/mac}
echo        Gateway     : ${net0/gateway}
echo        Platform    : ${platform}
echo
echo    ==========================================
echo
echo        Mencoba boot via snponly.efi...
echo
sanboot --no-describe ${168:string}:000 || goto fallback
exit

:fallback
echo
echo    ==========================================
echo        snponly gagal, fallback ipxe.efi...
echo    ==========================================
sleep 2
chain --replace ipxe.efi || goto boot_failed

:boot_failed
echo
echo  ==========================================
echo   BOOT GAGAL
echo   Periksa VHD Mapping dan Writeback di Dashboard.
echo   Pastikan port iSCSI 3260/3300 dan IP server benar.
echo  ==========================================
echo
echo  Tekan Enter untuk mencoba lagi...
prompt
goto start
