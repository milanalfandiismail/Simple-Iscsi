#!ipxe
:start
echo [CCBoot] Target IQN : ${169:string}
echo [CCBoot] Hostname   : ${net0/hostname}
echo [CCBoot] Root-Path  : ${root-path}
isset ${170:string} && sanhook --drive 0x81 ${170:string} || isset ${168:string} && sanhook --drive 0x81 iscsi:${168:string}::3300:0:iqn.2024-01.com.tmdebug:gamedisks || isset ${168:string} && sanhook --drive 0x81 iscsi:${168:string}::3260:0:iqn.2024-01.com.tmdebug:gamedisks ||
isset ${root-path} && sanboot --no-describe --drive 0x80 ${root-path} ||
isset ${169:string} && sanboot --no-describe --drive 0x80 iscsi:${168:string}::3300:0:${169:string} ||
isset ${169:string} && sanboot --no-describe --drive 0x80 iscsi:${168:string}::3260:0:${169:string} ||
isset ${169:string} && sanboot --no-describe --drive 0x80 iscsi:${168:string}::::${169:string} ||
goto boot_failed

:boot_failed
echo
echo  ==========================================
echo   BOOT GAGAL
echo   Periksa VHD Mapping dan Writeback di Dashboard.
echo   Pastikan port iSCSI 3260/3300 dan IP server benar.
echo  ==========================================
echo
echo  Tekan Enter untuk mencoba lagi...
prompt
goto start
