# config.toml.example - Contoh Konfigurasi Utama Server
# Salin file ini menjadi config.toml untuk konfigurasi lokal

gamedisk = []

# Contoh GameDisk per volume:
# [[gamedisk]]
# volume = "G:"
# physical_disk = ""
# block_size = 512
# vendor_id = "RUSTISCS"
# product_id = "GameDisk"
# product_revision = "1.00"
# ram_cache_mb = 0

[server]
address = "0.0.0.0"
port = 3260
read_cache_gb = 4

[gamedisk_target]
target_iqn = "iqn.2024-01.com.example:gamedisks"
discovery = true
vendor_id = "RUSTISCS"
product_id = "GameDisk"
product_revision = "1.00"

[windows]
target_iqn_prefix = "iqn.2024-01.com.example:vhd-"
vhd_dir = ""
block_size = 512
vendor_id = "RUSTISCS"
product_id = "WindowsBoot"
product_revision = "1.00"
discovery = false
super_client_ip = ""
super_client_action = "none"
ram_cache_mb = 0
client_cache_enabled = false

[writeback]
writeback_dirs = []
# Writeback .bin 4KB COW. Tidak ada cap per client.
max_writeback_per_client_gb = 0
max_write_speed_mbps = 100000
ram_cache_mb = 0

[image_manager]
win10 = 'D:\Images\Windows10.vhd'

[dhcp]
enabled = true
start_ip = "192.168.1.100"
end_ip = "192.168.1.200"
router = "192.168.1.1"
dns = "8.8.8.8"
next_server = "192.168.1.2"
subnet_mask = "255.255.255.0"
tftp_dir = "pxe"
pxe_default = "sb-custom"
nic_ips = ["192.168.1.2"]
auto_add_client = true
