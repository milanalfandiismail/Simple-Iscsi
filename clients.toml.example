# clients.toml.example - Contoh Konfigurasi Klien DHCP & iSCSI
# Salin file ini menjadi clients.toml untuk konfigurasi lokal

[[client]]
hostname = "PC-01"
mac = "00:11:22:33:44:55"
ip = "192.168.1.101"
gateway = "192.168.1.1"
dns = "8.8.8.8"
pxe = "sb-custom"
next_server = "192.168.1.2"
image_manager = "win10"

# Cache client CCacheX (hanya untuk driver CCBoot)
driver = "ccboot"
cache_enabled = true
cache_size_mb = 2048   # 0 = auto 20% RAM; 32-8192; kelipatan 16

[[client]]
hostname = "PC-02"
mac = "00:11:22:33:44:56"
ip = "192.168.1.102"
gateway = "192.168.1.1"
dns = "8.8.8.8"
pxe = "sb-custom"
next_server = "192.168.1.2"
image_manager = "win10"
